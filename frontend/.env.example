# Copy to .env.production (or .env.local) and set for your deployment.
#
# Absolute origin of the backend API. Leave EMPTY for local development —
# `npm run dev` proxies the API paths to localhost:8000 via vite.config.ts,
# and an empty base keeps that working.
#
# Set it when the dashboard is served from a different origin than the API
# (e.g. static/FTP hosting + the backend on GCP). No trailing slash.
#
#   VITE_API_BASE=https://uxagent-backend-xxxx.run.app
VITE_API_BASE=

# Note: there is no key/secret here on purpose. The access password is typed by
# the user and kept in localStorage — baking it into the build would ship it to
# anyone who opens the bundle in devtools.
