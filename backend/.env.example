# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Dashboard access -------------------------------------------------------
# Shared password the dashboard asks for. The frontend stores what the user
# types and sends it as the X-API-Key header.
#
# LEAVE EMPTY/UNSET for local development and tests: the gate then does not
# exist and every endpoint is open, which is what keeps `npm run dev` and the
# test suite working without a secret.
#
# MUST be set for any deployment reachable from the internet — without it
# anyone can start runs against your LLM budget.
UXAGENT_API_KEY=

# Comma-separated origin allowlist for the dashboard when it is served from a
# different host than this API. Empty = same-origin only.
#   CORS_ORIGINS=https://ux.example.com,https://staging.example.com
CORS_ORIGINS=

# --- Durable run history ----------------------------------------------------
# GCS bucket that finished runs are archived to. REQUIRED on Cloud Run: the
# container filesystem is wiped on every restart and redeploy, so without this
# run history only lasts as long as one instance.
#
# Keep the bucket PRIVATE. Access is via the Cloud Run service account, and the
# app serves the data behind UXAGENT_API_KEY — a public bucket would hand out
# every screenshot and report with no password at all.
#
# Empty (the default) = local disk only, which is what you want for dev.
#   UXAGENT_RUNS_BUCKET=uxagent-runs
UXAGENT_RUNS_BUCKET=

# Archive the debug artefacts too (api_trace, raw_html, simp_html, full-page
# screenshots). They are ~90% of a run's size and nothing in the dashboard
# reads them, so the default drops them: ~22 MB per persona instead of ~202 MB.
# Reports, evidence thumbnails and the offline re-analysis scripts all still
# work. Set true only if you need full session forensics after a redeploy.
UXAGENT_RUNS_ARCHIVE_ALL=false

# --- LLM providers ----------------------------------------------------------
# Provider actually used is set by llm_provider in conf/base.yaml.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Vertex AI (the default provider). GOOGLE_APPLICATION_CREDENTIALS points at
# the service-account JSON — a path, not the key itself.
GOOGLE_APPLICATION_CREDENTIALS=conf/gcp-service-account.json
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=us-central1

# AWS Bedrock (only if llm_provider is "aws")
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# --- Misc -------------------------------------------------------------------
GOOGLE_PAGESPEED_API_KEY=
# Run browsers headless (true/false)
HEADLESS=true
