# UXAgent backend — Flask API + Playwright agent pipeline.
#
# Base image choice: python:3.12-slim + `playwright install --with-deps`,
# rather than mcr.microsoft.com/playwright/python:vX.Y.Z. The Playwright image
# pins the browser version in the image tag, which then has to be kept in sync
# with uv.lock by hand. Installing the browser from the resolved package
# guarantees the binary matches the library instead.
#
# (uv.lock used to carry two playwright versions at once — 1.48.0 and 1.59.0 —
# because requires-python said ">=3.8" while everything else said 3.12. Raising
# the floor to 3.12 collapsed the lockfile from ~175 packages with duplicate
# resolutions to 83 with one version each.)
#
# Build (from backend/):    docker build -t uxagent-backend .
# Run locally:              docker run --rm -p 8080:8080 --env-file .env uxagent-backend

FROM python:3.12-slim AS base

# uv, from the official distroless image.
#
# This version must be >= the uv that generated uv.lock, and is pinned to match
# it exactly. An older uv fails at `uv sync --frozen` with a TOML parse error
# ("missing field `version`") because newer lock revisions omit `version` on the
# editable root package — which reads like a corrupt lockfile but is purely a
# version mismatch. Bump this whenever the lockfile is regenerated by a newer uv.
COPY --from=ghcr.io/astral-sh/uv:0.11.13 /uv /usr/local/bin/uv

ENV PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    # Browsers go to a shared path, not ~/.cache, so the non-root runtime user
    # can read what root installed below.
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    # Use the model map bundled with the pinned litellm, not the copy it
    # downloads from GitHub on import. When that remote file dropped
    # claude-sonnet-4-20250514 the router could not be built and the service
    # failed to boot. Also set in simulated_web_agent/__init__.py; repeated here
    # so nothing that imports litellm first can bypass it.
    LITELLM_LOCAL_MODEL_COST_MAP=True

WORKDIR /app

# ── Dependencies (cached layer) ──────────────────────────────────────────────
# Copy only the manifests first so a source-only change doesn't reinstall
# ~175 packages. --no-install-project: the project itself comes later.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

# ── Chromium + its system libraries ──────────────────────────────────────────
# --with-deps runs apt-get for the shared libs chromium needs; must happen as
# root, before dropping privileges.
#
# Invoked via .venv/bin, NOT `uv run`: at this point only pyproject.toml and
# uv.lock have been copied, and `uv run` would try to install the project
# itself, which reads its version from src/simulated_web_agent/__about__.py —
# a file that does not arrive until the COPY below. Keeping this layer before
# the source copy is deliberate: it is by far the slowest step, and it must not
# be invalidated every time a source file changes.
# xvfb is installed alongside it: a virtual X display, so the browser can run
# headed in a container that has no screen.
#
# Not a convenience — it decides whether some sites can be audited at all.
# hebe.pl serves Cloudflare's "verify you are human" interstitial to headless
# Chromium and the real site to a headed one: same machine, same IP, same URL,
# seconds apart. Every session in the review re-run spent all 16 and all 9 of
# its steps on that challenge page, and the first external review's hebe
# report — six critical "site" defects — was generated entirely from it.
#
# Nothing here spoofs or patches anything. It is an ordinary Chrome with an
# ordinary display; the only thing that changes is that the display exists.
#
# xauth and x11-xkb-utils are listed on purpose. Debian only *recommends* them
# for xvfb, this install skips recommends, and playwright's own dependency list
# has neither: xvfb-run stops with "xauth command not found", and Xvfb cannot
# start without xkbcomp. The container then exited before it ever listened on
# the port — the 2026-09-30 deploy (revision ux-agent-00014) failed on it.
RUN .venv/bin/playwright install --with-deps chromium \
    && apt-get update \
    && apt-get install -y --no-install-recommends xvfb xauth x11-xkb-utils \
    && rm -rf /var/lib/apt/lists/*

# ── Application ──────────────────────────────────────────────────────────────
COPY . .
RUN uv sync --frozen --no-dev

# Serve with gunicorn rather than Flask's dev server. Installed here, not in
# pyproject: it is a deployment concern, not a library dependency. --python
# pins it to the project venv rather than relying on discovery, and the
# version is pinned because this install is outside uv.lock — unpinned, every
# rebuild could pull a different gunicorn, which is exactly the drift the uv
# pin above exists to prevent.
RUN uv pip install --python .venv/bin/python 'gunicorn==23.0.0'

# ── Runtime user ─────────────────────────────────────────────────────────────
# Non-root is required, not just good practice: conf/base.yaml passes no
# --no-sandbox flag, and chromium's sandbox refuses to start as root.
# browser_session/ (user_data_dir) and runs/ are written at runtime, so they
# must be owned by that user.
RUN useradd --create-home --uid 1001 uxagent \
    && mkdir -p /app/runs /app/browser_session /app/browser_cache \
    && chown -R uxagent:uxagent /app \
    && chmod -R a+rX /ms-playwright
USER uxagent

# Cloud Run injects PORT (8080 by default); honour it, with a local fallback.
ENV PORT=8080
EXPOSE 8080

# One worker, many threads — deliberate. The pipeline is kicked off in a
# background thread and tracked in an in-memory RUNS registry (main/app.py);
# a second worker would have its own copy, so a run started on one worker
# would be invisible to /progress served by the other.
# --timeout 0 disables the worker kill: reading a large run's trace can take a
# while, and the audit threads must not be reaped mid-run.
# gunicorn is started exactly as in the last image that deployed (0faedd1), as
# the container's main process. The virtual display for headed runs is started
# BESIDE it, in the background, and nothing waits for it.
#
# From 5d2690f the server was started inside `xvfb-run`, which waits for Xvfb
# to report ready before it starts its command. Every deploy since then failed
# the same way: Cloud Run's startup probe never found port 8080 open (revisions
# ux-agent-00014 and -00015, 2026-09-30). gunicorn opens the port before it
# loads the app, so a closed port for four minutes means gunicorn never
# started — the wait in front of it never ended. With Xvfb backgrounded, a
# display that fails or hangs costs only the headed runs, never the service.
CMD Xvfb :99 -screen 0 1440x900x24 -nolisten tcp >/tmp/xvfb.log 2>&1 & \
    export DISPLAY=:99; \
    exec .venv/bin/gunicorn \
    --bind "0.0.0.0:${PORT}" \
    --workers 1 \
    --threads 8 \
    --timeout 0 \
    --access-logfile - \
    --access-logformat '%(h)s %(m)s %(U)s %(s)s %(b)s %(L)s' \
    --error-logfile - \
    simulated_web_agent.main.app:app

# ── Deployment notes ─────────────────────────────────────────────────────────
# Cloud Run:
#   gcloud run deploy uxagent-backend --source . \
#     --region europe-central2 --memory 4Gi --cpu 2 \
#     --no-cpu-throttling --timeout 3600 \
#     --min-instances 1 --max-instances 1 \
#     --set-secrets UXAGENT_API_KEY=<secret-name>:latest \
#     --set-env-vars VERTEXAI_PROJECT=<project>,VERTEXAI_LOCATION=<region> \
#     --set-env-vars CORS_ORIGINS=https://<your-dashboard-host>
#
#   Hosted on csaapps.pl with Microsoft SSO instead of (or beside) the shared
#   key: add the two lines below and register the app with the csaapps.pl
#   administrators. CORS_ORIGINS must then be exactly https://csaapps.pl.
#     --set-secrets AUTH_SECRET=<app>-auth-secret:latest \
#     --update-env-vars "^;^ALLOWED_DOMAINS=<domain1>,<domain2>"
#   (the "^;^" prefix makes ';' the separator so the comma list survives.)
#
#   Every flag above is load-bearing. This block used to list only the first
#   four, and a deployment made from it was OOM-killed 21 seconds into every
#   run while serving an unauthenticated API.
#
#   * UXAGENT_API_KEY: without it app.py leaves EVERY endpoint open — anyone
#     with the URL can start runs against your LLM budget. It warns at boot.
#   * AUTH_SECRET / ALLOWED_DOMAINS: SSO mode. The dashboard on csaapps.pl gets a
#     short-lived signed token from https://csaapps.pl/auth/token.php?aud=<app>
#     and sends it as 'Authorization: Bearer'; main/sso_auth.py checks the
#     signature, expiry and e-mail domain. ALLOWED_DOMAINS is default-deny: with
#     AUTH_SECRET set and no domain, every token is rejected (logged at boot).
#     UXAGENT_API_KEY keeps working beside it; a request needs either.
#     Register once (guide steps): (1) pick an audience name (default 'uxagent');
#     (2) openssl rand -hex 32 | tr -d '\n' | gcloud secrets create
#     <app>-auth-secret --data-file=- --project <P> --replication-policy=user-managed
#     --locations=europe-central2; (3) the --set-secrets/--update-env-vars above;
#     (4) grant the administrators roles/secretmanager.secretAccessor on that
#     secret and tell them audience, project and secret name (never the secret
#     itself, by mail or chat) - they add it to /auth/app_secrets.php;
#     (5) logged in, https://csaapps.pl/auth/token.php?aud=<app> must return JSON
#     with access_token. Get the domain for ALLOWED_DOMAINS from the 'email'
#     field of https://csaapps.pl/auth/me.php.
#     Rotation: add a new secret version, redeploy the service, and have the
#     administrators swap the app_secrets.php entry at the same time - until
#     then users get 401.
#     Logging: ?token= / ?key= must not reach logs. gunicorn's access log is
#     therefore configured to print the path without the query string; Cloud
#     Run's own request log still records the full URL, which is why tokens are
#     short-lived.
#   * CORS_ORIGINS: without it a dashboard on another host cannot call the API,
#     and for screenshots the failure is a silent broken image, because browsers
#     do not apply CORS to <img src>.
#   * VERTEXAI_PROJECT / VERTEXAI_LOCATION: litellm resolves the Vertex endpoint
#     from the environment, not from conf/base.yaml. Gemini model availability
#     differs by region — a model-not-found at run time points here.
#   * --no-cpu-throttling (CPU always allocated) is REQUIRED. The audit runs in
#     a background thread after the HTTP response returns; with the default
#     request-scoped CPU it would be throttled to a stop mid-run.
#   * --min/--max-instances 1 for the same reason as --workers 1: run state is
#     in-memory, so it must not be spread across instances.
#   * Memory: chromium is heavy and personas run concurrently. 4Gi is a
#     starting point — raise it if sessions die at higher concurrency. The
#     symptom is a "Memory limit of N MiB exceeded" line seconds after
#     POST /run, which from the dashboard looks like a persona that never
#     starts rather than an infrastructure failure.
#
# Credentials: do NOT bake .env or a service-account key into the image. On
# Cloud Run, attach a service account and let Application Default Credentials
# supply Vertex AI — GOOGLE_APPLICATION_CREDENTIALS is then unnecessary. Set
# VERTEXAI_PROJECT / VERTEXAI_LOCATION / GOOGLE_PAGESPEED_API_KEY as env vars
# or Secret Manager references.
#
# Storage: runs/ inside the container is ephemeral and is lost on every restart
# or redeploy. Set UXAGENT_RUNS_BUCKET and run history becomes durable —
# main/run_storage.py uploads each finished run and fetches it back on demand,
# so any instance can serve a run it did not execute:
#
#   gcloud storage buckets create gs://<bucket> --location europe-central2 \
#     --uniform-bucket-level-access          # keep it PRIVATE
#   gcloud storage buckets add-iam-policy-binding gs://<bucket> \
#     --member serviceAccount:<run-sa> --role roles/storage.objectAdmin
#   gcloud run services update uxagent-backend --region europe-central2 \
#     --set-env-vars UXAGENT_RUNS_BUCKET=<bucket>
#
#   Deliberately NOT a gcsfuse mount at /app/runs, even though that needs no
#   code: observation_trace.jsonl is opened in append mode once per step (on
#   GCS an append rewrites the whole object), Playwright writes ~2.7 MB
#   screenshots straight to the path on the agent's hot path, and a 20-persona
#   run writes ~12,900 files. Writing locally and uploading once at the end
#   keeps all of that on local disk where it is fast and atomic.
#
#   The archive skips api_trace/, raw_html/, simp_html/ and full-page
#   screenshots — ~90% of the bytes, none of it read by the dashboard.
#   UXAGENT_RUNS_ARCHIVE_ALL=true keeps everything.
#
# If chromium still fails to launch on Cloud Run's gVisor sandbox, add
# "--no-sandbox" to environment.browser.launch_options.args in conf/base.yaml.
#
# Bot protection: sites behind Cloudflare, DataDome or PerimeterX commonly pass
# a headed browser and challenge a headless one. Untick "headless" in the
# wizard for those; the xvfb above is what makes that possible here. A run that
# never gets past the challenge now ends as an explicit error rather than a
# fabricated report — but an error is still not an audit. For a client
# engagement the durable fix is asking them to allowlist the auditing IP or
# user-agent, which also survives the vendor tightening its heuristics.
