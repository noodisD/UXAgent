# Run artifacts — 3.8GB locally and growing. Never belongs in an image; on
# Cloud Run this data lives in GCS instead (see Dockerfile notes).
runs/
browser_cache/
browser_session/
personas.json
*.log

# Secrets — provided at runtime as env vars / the attached service account,
# never baked into a layer.
.env
.env.*
conf/gcp-service-account.json
*.json.key

# Local virtualenv (absolute paths inside; must be rebuilt in the image)
.venv/

# Python bytecode / caches
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Tests and dev-only tooling are not needed to serve the API
tests/

# VCS / editor
.git/
.gitignore
.vscode/
.idea/
